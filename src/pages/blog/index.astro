---
import Base from '../../layouts/Base.astro';
import { SITE } from '../../config';
import { getCollection } from 'astro:content';

const posts = (await getCollection('blog')).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf(),
);
const fmtDate = (d: Date) => d.toISOString().slice(0, 10);
---

<Base title={`Writing — ${SITE.name}`} description="Posts by Liron Katsif.">
  <section class="page">
    <h2 class="sec"><b>◆</b> writing</h2>
    <ol class="posts">
      {
        posts.map((post) => (
          <li>
            <a href={`/blog/${post.id}/`}>
              <span class="t">{post.data.title}</span>
              <span class="d">{post.data.description}</span>
            </a>
            <span class="mono date">{fmtDate(post.data.date)}</span>
          </li>
        ))
      }
    </ol>
  </section>
</Base>

<style>
  section { padding-top: 64px; }
  .posts { list-style: none; }
  .posts li {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 32px;
    padding: 20px 0;
    border-bottom: 1px solid var(--hairline);
  }
  .posts a { text-decoration: none; display: block; }
  .posts .t { display: block; font-size: 18px; font-weight: 500; }
  .posts a:hover .t { color: var(--accent); }
  .posts .d {
    display: block;
    margin-top: 6px;
    font-size: 14px;
    color: var(--ink-dim);
    max-width: 58ch;
  }
  .date { color: var(--ink-faint); font-size: 12px; white-space: nowrap; }
  @media (max-width: 720px) {
    .posts li { flex-direction: column; gap: 8px; }
  }
</style>

# Copy to .env for local dev, and set the same keys in Vercel → Project → Settings → Environment Variables.
# See docs/MARKET.md for what each one does and the go-live checklist.

# ── safety ─────────────────────────────────────────────────────────
# The market is HALTED unless this is exactly "false". Flip it yourself to go live.
MARKET_HALTED=true

# ── chain ──────────────────────────────────────────────────────────
SOLANA_CLUSTER=devnet                 # devnet | mainnet-beta
SOL_RECIPIENT=GQWyY1KZUp4ZXWh3mEMc83ibA4fWHRKcPKc9qMfEeVWy
SOLANA_RPC=                           # server-side RPC (Helius/QuickNode URL with key). Never shipped to browsers.
PUBLIC_SOLANA_RPC=                    # browser RPC for the wallet button (a domain-restricted key)
# USDC_MINT=                          # optional override; defaults to the right USDC mint for the cluster

# ── storage (Upstash Redis via Vercel Marketplace) ──────────────────
KV_REST_API_URL=
KV_REST_API_TOKEN=

# ── owner ──────────────────────────────────────────────────────────
ADMIN_TOKEN=                          # long random string; unlocks /admin
BOOKING_URL=                          # revealed only after a confirmed payment (e.g. a Cal.com event)
CONTACT_EMAIL=lkatsif@uwaterloo.ca

# ── notifications (optional; both can be set) ───────────────────────
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
RESEND_API_KEY=
NOTIFY_EMAIL=
# RESEND_FROM="LIRON/USDC <market@yourdomain>"

# ORDER_TTL_SEC=900                   # how long an unpaid order holds its blocks
